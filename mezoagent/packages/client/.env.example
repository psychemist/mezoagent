# Mezo Client Configuration

# URL for the Mezo RPC Endpoint (can be local or remote)
VITE_MEZO_RPC_URL=https://rpc.mezo.org

# Your Agent's Smart Account Address on Mezo
VITE_MEZO_SMART_ACCOUNT_ADDRESS=0xYOUR_SMART_ACCOUNT_ADDRESS

# Optional: Token Addresses (defaults are provided in code)
# VITE_MEZO_TBTC_ADDRESS=
# VITE_MEZO_MUSD_ADDRESS=
