# Mezo Network Configuration
MEZO_RPC_URL=https://rpc.mezo.org
MEZO_NETWORK=mainnet # or testnet
MEZO_CHAIN_ID=1

# Wallet Configuration
MEZO_PRIVATE_KEY=0x... # Your agent's private key
MEZO_SMART_ACCOUNT_ADDRESS=0x... # EIP-4337 smart account address

# Token Addresses
MEZO_TOKEN_ADDRESS=0x... # MEZO token contract
MEZO_TBTC_ADDRESS=0x... # tBTC token contract
MEZO_USDC_ADDRESS=0x... # USDC token contract

# Protocol Contracts
MEZO_TIGRIS_ADDRESS=0x... # Tigris DEX contract
MEZO_UPSHIFT_ADDRESS=0x... # Upshift yield protocol contract
MEZO_ENTRYPOINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789 # EIP-4337 EntryPoint

# Paymaster Configuration (Optional - for gasless transactions)
MEZO_PAYMASTER_ENDPOINT=https://paymaster.mezo.org
MEZO_PAYMASTER_ADDRESS=0x... # Primary paymaster contract
MEZO_PAYMASTER_BACKUP_ADDRESS=0x... # Backup paymaster contract

# Treasury Configuration
MEZO_EMERGENCY_FUNDING_ADDRESS=0x... # External wallet for emergency funding
TREASURY_ALERT_WEBHOOK=https://... # Webhook URL for treasury alerts (Discord, Slack, etc.)

# X402 Configuration (Treasury Thresholds in wei)
X402_MIN_RESERVE=10000000000000000000 # 10 MEZO
X402_WARNING_THRESHOLD=20000000000000000000 # 20 MEZO
X402_CRITICAL_THRESHOLD=5000000000000000000 # 5 MEZO
X402_AUTO_REFUND_ENABLED=true

# X402 Gas Configuration
X402_MAX_GAS_PRICE=100000000000 # 100 gwei
X402_GAS_OPTIMIZATION_ENABLED=true
X402_BATCHING_ENABLED=true
X402_GAS_MULTIPLIER=1.2
X402_PRIORITY_FEE=2000000000 # 2 gwei

# X402 Paymaster Configuration
X402_PAYMASTER_ENABLED=true
X402_PAYMASTER_FALLBACK=true
X402_PAYMASTER_STRATEGY=token-based # token-based | whitelist | stake-based

# X402 Limits
X402_MAX_OPERATION_COST=1000000000000000000 # 1 MEZO
X402_MAX_OPERATIONS_PER_HOUR=100
X402_MAX_DAILY_SPEND=50000000000000000000 # 50 MEZO

# X402 Funding Configuration
X402_FUNDING_SOURCES=upshift-yields,external-wallet # comma-separated: upshift-yields, external-wallet, credit-line
X402_AUTO_HARVEST_ENABLED=true
X402_HARVEST_THRESHOLD=5000000000000000000 # 5 MEZO

# Human Decisions (Configure based on your preferences)
# Gas Sponsorship Strategy: always | hybrid | never
X402_GAS_SPONSORSHIP_STRATEGY=hybrid

# Risk Tolerance: conservative | balanced | aggressive
X402_RISK_TOLERANCE=balanced

# Emergency Shutdown Triggers
X402_EMERGENCY_BALANCE_THRESHOLD=1000000000000000000 # 1 MEZO
X402_EMERGENCY_FAILURE_THRESHOLD=10 # consecutive failures
X402_EMERGENCY_GAS_PRICE_THRESHOLD=500000000000 # 500 gwei
