{
    "name": "@elizaos/plugin-mezo",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "package.json"
    ],
    "dependencies": {
        "@elizaos/core": "workspace:*",
        "bun": "^1.3.4"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "gpt-3-encoder": "^1.1.4",
        "typescript": "^5.0.0"
    },
    "scripts": {
        "build": "bun run build.ts",
        "dev": "bun run build.ts --watch",
        "lint": "eslint src/ --ext .ts",
        "test": "bun test"
    },
    "publishConfig": {
        "access": "public"
    }
